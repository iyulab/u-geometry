{
  "$schema": "scripts/engine-card/engine-card.schema.json",
  "card_version": 1,
  "engine": {
    "id": "u-geometry",
    "summary": "2D computational geometry on polygons given as point lists: area, convex hull, point containment, overlap, boundary clearance, bounding box and rigid transforms.",
    "version": "0.6.2",
    "license": "MIT",
    "repository": "https://github.com/iyulab/u-geometry"
  },
  "surfaces": [
    {
      "kind": "crate",
      "name": "u-geometry",
      "package_version": "0.6.2",
      "engine_version": "0.6.2",
      "error_shape": "Nothing is refused: the functions take typed slices, and one with no answer for an empty input returns None."
    },
    {
      "kind": "npm",
      "name": "@iyulab/u-geometry",
      "package_version": "0.6.2",
      "engine_version": "0.6.2",
      "wasm": true,
      "note": "Points are {x, y} objects; arguments and results are typed in the .d.ts (Point2D, Aabb). Bundler and Node targets; no bundler-less browser build.",
      "error_shape": "A thrown Error whose code property is the code, with parameter (and index, for an element) as its other properties."
    }
  ],
  "errors": {
    "shape": "A refusal carries a stable snake_case 'code' and the argument it is about ('parameter'); only the WebAssembly surface refuses.",
    "source": {
      "catalog": "code_catalog in src/wasm.rs, built from the Code table the refusals are made from; published as codes() in WebAssembly. What each code means is tabled in README.md, which a test holds equal to the catalog.",
      "test": "src/wasm.rs::code_catalog_tests::the_readme_documents_every_code_and_no_other"
    }
  },
  "operations": [
    {
      "id": "polygon_area",
      "summary": "The unsigned area of a simple polygon (shoelace formula); fewer than three points give 0.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/polygon_area.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/polygon_area.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "none"
      },
      "performance": {
        "status": "none",
        "complexity": "O(n) in the point count."
      }
    },
    {
      "id": "convex_hull",
      "summary": "The convex hull of a point set, counter-clockwise from the lowest point, with collinear points dropped (Graham scan, robust orientation tests); fewer than three points come back as given.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/convex_hull.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
