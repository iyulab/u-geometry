{
  "$schema": "scripts/engine-card/engine-card.schema.json",
  "card_version": 1,
  "engine": {
    "id": "u-geometry",
    "summary": "2D computational geometry on polygons given as point lists: area, convex hull, point containment, overlap, boundary clearance, bounding box and rigid transforms.",
    "version": "0.6.2",
    "license": "MIT",
    "repository": "https://github.com/iyulab/u-geometry"
  },
  "surfaces": [
    {
      "kind": "crate",
      "name": "u-geometry",
      "package_version": "0.6.2",
      "engine_version": "0.6.2",
      "error_shape": "Nothing is refused: the functions take typed slices, and one with no answer for an empty input returns None."
    },
    {
      "kind": "npm",
      "name": "@iyulab/u-geometry",
      "package_version": "0.6.2",
      "engine_version": "0.6.2",
      "wasm": true,
      "note": "Points are {x, y} objects; arguments and results are typed in the .d.ts (Point2D, Aabb). Bundler and Node targets; no bundler-less browser build.",
      "error_shape": "A thrown Error whose code property is the code, with parameter (and index, for an element) as its other properties."
    }
  ],
  "errors": {
    "shape": "A refusal carries a stable snake_case 'code' and the argument it is about ('parameter'); only the WebAssembly surface refuses.",
    "source": {
      "catalog": "code_catalog in src/wasm.rs, built from the Code table the refusals are made from; published as codes() in WebAssembly. What each code means is tabled in README.md, which a test holds equal to the catalog.",
      "test": "src/wasm.rs::code_catalog_tests::the_readme_documents_every_code_and_no_other"
    }
  },
  "operations": [
    {
      "id": "polygon_area",
      "summary": "The unsigned area of a simple polygon (shoelace formula); fewer than three points give 0.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/polygon_area.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/polygon_area.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "The unsigned area of 24 simple polygons equals shapely's, whichever way the ring winds.",
            "reference_kind": "reference_implementation",
            "reference": "shapely 2.2.0 (GEOS) Polygon.area",
            "method": "compares seeded star-shaped polygons (24 pairs overlapping, disjoint and nested; 8 point sets of 20 to 59 points)",
            "tolerance": "1e-12 (relative)",
            "test": "tests/reference_shapely.rs::polygon_area_matches_shapely"
          }
        ],
        "limits": [
          "Simple polygons without holes."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n) in the point count."
      }
    },
    {
      "id": "convex_hull",
      "summary": "The convex hull of a point set, counter-clockwise from the lowest point, with collinear points dropped (Graham scan, robust orientation tests); fewer than three points come back as given.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/convex_hull.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/convex_hull.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "The hull has shapely's vertex set (collinear points dropped), runs counter-clockwise and starts at the lowest point.",
            "reference_kind": "reference_implementation",
            "reference": "shapely 2.2.0 MultiPoint.convex_hull",
            "method": "compares six random normal point sets",
            "tolerance": "1e-12 (absolute) per vertex",
            "test": "tests/reference_shapely.rs::convex_hull_matches_shapely_as_a_set_and_runs_counter_clockwise_from_the_lowest_point"
          }
        ],
        "limits": [
          "Generic position; degenerate inputs (all collinear, duplicates) are covered by unit tests."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n log n) time, O(n) space."
      }
    },
    {
      "id": "point_in_polygon",
      "summary": "Whether a point lies inside a simple polygon or on its boundary (winding number).",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/point_in_polygon.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/point_in_polygon.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "A point is reported inside exactly when shapely's covers() is true (interior or boundary).",
            "reference_kind": "reference_implementation",
            "reference": "shapely 2.2.0 Polygon.covers",
            "method": "96 random query points against eight seeded star-shaped polygons (star polygons overlapping, disjoint and nested",
            "tolerance": "exact",
            "test": "tests/reference_shapely.rs::point_in_polygon_matches_shapely_covers"
          }
        ],
        "limits": [
          "Random points rarely land on the boundary; boundary points are covered by unit tests."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n) in the polygon's point count."
      }
    },
    {
      "id": "polygons_intersect",
      "summary": "Whether the interiors of two simple polygons, convex or concave, overlap; polygons that only share an edge or a vertex do not.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/polygons_intersect.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/polygons_intersect.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "Two polygons are reported overlapping exactly when their interiors intersect (shapely's relate pattern T********); polygons that share only an edge or a vertex are not; the answer is the same for the coordinates multiplied by 1e-9 and 1e6.",
            "reference_kind": "reference_implementation",
            "reference": "shapely 2.2.0 relate_pattern(b, 'T********')",
            "method": "compares 24 pairs at three coordinate units, and square pairs sharing an edge, a corner and a nested square at four",
            "tolerance": "exact",
            "test": "tests/reference_shapely.rs::polygon_overlap_and_boundary_distance_match_shapely_in_every_unit"
          }
        ],
        "limits": [
          "Simple polygons without holes; the unit change is by factors that are not powers of two, so the pairs are in generic position."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n·m) in the two point counts, after a bounding-box reject."
      }
    },
    {
      "id": "boundary_distance",
      "summary": "The smallest distance between the boundaries of two polygons: 0 when they touch or cross, the gap when one sits strictly inside the other. One point is a point, two a segment.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/boundary_distance.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/boundary_distance.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "The smallest distance between the two boundaries equals shapely's distance between the exteriors (0 when they touch or cross), also in other units.",
            "reference_kind": "reference_implementation",
            "reference": "shapely 2.2.0 exterior.distance",
            "method": "compares 24 pairs at three coordinate units; edge-sharing squares give 0",
            "tolerance": "1e-9 (relative to the larger of the distance and 1)",
            "test": "tests/reference_shapely.rs::polygon_overlap_and_boundary_distance_match_shapely_in_every_unit"
          }
        ],
        "limits": [
          "A single point or segment as a polygon is covered by unit tests."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n·m) in the two point counts."
      }
    },
    {
      "id": "polygon_bounds",
      "summary": "The axis-aligned bounding box of a non-empty point set.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/polygon_bounds.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/polygon_bounds.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
