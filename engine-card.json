      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "Rotation about the origin by the angle, then translation, equals the matrix product, preserving distances and area.",
            "reference_kind": "literature",
            "reference": "the rotation matrix [cos -sin; sin cos] (counter-clockwise), then the translation",
            "method": "transforms three points and compares them, their distance and the triangle area",
            "tolerance": "1e-14 (absolute)",
            "test": "tests/reference_shapely.rs::rotation_then_translation_is_a_rigid_motion"
          }
        ],
        "limits": [
          "One angle and offset; reflections are not offered."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n) in the point count."
      }
    }
  ]
}
