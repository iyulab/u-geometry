      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "The bounding box is the coordinate-wise minima and maxima.",
            "reference_kind": "reference_implementation",
            "reference": "shapely 2.2.0 bounds (the definition)",
            "method": "compares six point sets",
            "tolerance": "exact",
            "test": "tests/reference_shapely.rs::bounds_are_the_coordinate_extremes"
          }
        ],
        "limits": [
          "Trivial by definition; the check guards the extremes against NaN ordering and empty input in unit tests."
        ]
      },
      "performance": {
        "status": "none",
        "complexity": "O(n) in the point count."
      }
    },
    {
      "id": "transform_points",
      "summary": "Rotates points about the origin by an angle in radians (counter-clockwise), then translates them; a rigid motion with no reflection.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/transform_points.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/transform_points.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
